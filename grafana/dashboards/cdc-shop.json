    {
      "id": 3,
      "type": "stat",
      "title": "CDC events / sec (last 1m)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT count() / 60 FROM (\nSELECT _source_ts, _ingested_at FROM shop.orders WHERE _ingested_at > now() - INTERVAL 1 MINUTE\nUNION ALL SELECT _source_ts, _ingested_at FROM shop.order_items WHERE _ingested_at > now() - INTERVAL 1 MINUTE\nUNION ALL SELECT _source_ts, _ingested_at FROM shop.customers WHERE _ingested_at > now() - INTERVAL 1 MINUTE\nUNION ALL SELECT _source_ts, _ingested_at FROM shop.products WHERE _ingested_at > now() - INTERVAL 1 MINUTE\n)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "CDC lag p95 (last 1m)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT quantile(0.95)(dateDiff('millisecond', _source_ts, _ingested_at)) FROM (\nSELECT _source_ts, _ingested_at FROM shop.orders WHERE _ingested_at > now() - INTERVAL 1 MINUTE\nUNION ALL SELECT _source_ts, _ingested_at FROM shop.order_items WHERE _ingested_at > now() - INTERVAL 1 MINUTE\nUNION ALL SELECT _source_ts, _ingested_at FROM shop.customers WHERE _ingested_at > now() - INTERVAL 1 MINUTE\nUNION ALL SELECT _source_ts, _ingested_at FROM shop.products WHERE _ingested_at > now() - INTERVAL 1 MINUTE\n)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Orders created",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
