      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT _ingested_at, _op, id, customer_id, status, total, _lsn\nFROM shop.orders\nORDER BY _ingested_at DESC\nLIMIT 50"
        }
