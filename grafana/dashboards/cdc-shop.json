      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT status, count() AS orders\nFROM shop.orders FINAL\nGROUP BY status\nORDER BY indexOf(['new','paid','shipped','delivered','cancelled'], status)"
        }
