      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(created_at) AS time, count() AS orders\nFROM shop.orders FINAL\nWHERE $__timeFilter(created_at)\nGROUP BY time ORDER BY time"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Revenue",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(created_at) AS time, sumIf(total, status != 'cancelled') AS revenue\nFROM shop.orders FINAL\nWHERE $__timeFilter(created_at)\nGROUP BY time ORDER BY time"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CDC events by operation",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(_ingested_at) AS time,\n  countIf(_op = 'c') AS insert,\n  countIf(_op = 'u') AS update,\n  countIf(_op = 'd') AS delete,\n  countIf(_op = 'r') AS snapshot\nFROM (\nSELECT _op, _ingested_at FROM shop.orders WHERE $__timeFilter(_ingested_at)\nUNION ALL SELECT _op, _ingested_at FROM shop.order_items WHERE $__timeFilter(_ingested_at)\nUNION ALL SELECT _op, _ingested_at FROM shop.customers WHERE $__timeFilter(_ingested_at)\nUNION ALL SELECT _op, _ingested_at FROM shop.products WHERE $__timeFilter(_ingested_at)\n)\nGROUP BY time ORDER BY time"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CDC lag (Postgres commit -> ClickHouse)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(_ingested_at) AS time,\n  quantile(0.5)(dateDiff('millisecond', _source_ts, _ingested_at)) AS p50,\n  quantile(0.95)(dateDiff('millisecond', _source_ts, _ingested_at)) AS p95,\n  max(dateDiff('millisecond', _source_ts, _ingested_at)) AS max\nFROM (\nSELECT _source_ts, _ingested_at FROM shop.orders WHERE $__timeFilter(_ingested_at)\nUNION ALL SELECT _source_ts, _ingested_at FROM shop.order_items WHERE $__timeFilter(_ingested_at)\nUNION ALL SELECT _source_ts, _ingested_at FROM shop.customers WHERE $__timeFilter(_ingested_at)\nUNION ALL SELECT _source_ts, _ingested_at FROM shop.products WHERE $__timeFilter(_ingested_at)\n)\nGROUP BY time ORDER BY time"
        }
      ]
    },
    {
      "id": 9,
